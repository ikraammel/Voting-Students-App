rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Collection Events
    match /Events/{eventId} {
      allow read: if request.auth != null;        // Lire les events si connecté
      allow update: if request.auth != null;      // Compteurs mis à jour uniquement via transaction voteEvent

      // Sous-collection votes (vote unique)
      match /votes/{userId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Collection globale Votes
    match /Votes/{voteId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
